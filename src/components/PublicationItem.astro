---
import { useTranslations, type Lang } from '../i18n';
import type { CollectionEntry } from 'astro:content';
import graph from '../data/topics.json';
import { peopleOf } from '../utils/authors';

interface Props {
  pub: CollectionEntry<'publications'>;
  lang: Lang;
}

const { pub, lang } = Astro.props;
const t = useTranslations(lang);
const { title, authors, venue, year, type, doi, url } = pub.data;
const link = doi ? `https://doi.org/${doi}` : url;

// Lets a click on the topic map filter this list. Same source as the map, so
// the two can never disagree about what a topic contains.
const entry = (graph.pubs as Record<string, { t: number[] }>)[pub.id];
const topics = entry?.t.map((i) => graph.nodes[i].id).join(' ');

// Resolved here with the same matcher that counts a graduate's publications on
// the alumni page, so the count they click and the list they land on agree.
const people = (await peopleOf(authors)).join(' ');
---

<li data-type={type} data-year={year} data-topics={topics} data-people={people}>
  <span class="authors">{authors.join(', ')} ({year}).</span>
  {link ? (
    <a href={link} target="_blank" rel="noopener"><strong>{title}</strong></a>
  ) : (
    <strong>{title}</strong>
  )}
  {venue && <span class="venue"> — {venue}</span>}
  <span class="tag blue">{t(`pubs.${type}`)}</span>
</li>
