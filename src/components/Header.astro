---
import { useTranslations, navTree, sectionOf, href, otherLang, assetPath, type Lang, type RouteKey } from '../i18n';
import LireiMark from './LireiMark.astro';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  switchHref?: string;
}

const { lang, routeKey, switchHref } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const section = sectionOf(routeKey);

// Inside a submenu a hub is named for its content, not for the section.
const subLabel: Partial<Record<RouteKey, string>> = { lab: 'overview', team: 'members' };
const label = (key: RouteKey, inSub = false) =>
  t(`nav.${inSub ? (subLabel[key] ?? key) : key}`);
---

<header class="site-header">
  <div class="container">
    <div class="brand">
      <a class="brand-link" href={href(lang, 'home')}>
        <LireiMark class="brand-mark" />
        <span class="brand-name">{t('site.name')}</span>
      </a>
      <span class="fullname">{t('site.fullname')}</span>
      <a
        class="uqtr-link"
        href="https://www.uqtr.ca/"
        target="_blank"
        rel="noopener"
        title={t('site.uqtr')}>
        <img src={assetPath('/images/uqtr-logo.png')} alt={t('site.uqtr')} width="360" height="140" />
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={t('nav.menuLabel')}>
        <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
    <nav class="site-nav" id="site-nav" aria-label={t('nav.menuLabel')}>
      {navTree.map((item) => (
        item.children ? (
          <div class:list={['nav-group', { 'is-section': item.key === section }]}>
            <a
              class="nav-group-link"
              href={href(lang, item.key)}
              aria-current={item.key === routeKey ? 'page' : undefined}>
              {label(item.key)}
              <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
            </a>
            <ul class="nav-sub">
              {item.children.map((child) => (
                <li class:list={{ 'is-self': child === item.key }}>
                  <a href={href(lang, child)} aria-current={child === routeKey ? 'page' : undefined}>
                    {label(child, true)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={href(lang, item.key)} aria-current={item.key === routeKey ? 'page' : undefined}>
            {label(item.key)}
          </a>
        )
      ))}
      <a class="lang" href={switchHref ?? href(other, routeKey)} lang={other} aria-label={t('nav.langLabel')}>
        {other.toUpperCase()}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });
    // Close when a link is followed on the same page (e.g. anchors).
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }
    });
  }
</script>
