---
import { useTranslations, href, assetPath, type Lang } from '../i18n';
import LireiMark from './LireiMark.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <a class="footer-brand" href={href(lang, 'home')}>
          <LireiMark class="footer-mark" />
          <span class="footer-name">{t('site.name')}</span>
        </a>
        <p>{t('site.fullname')}</p>
        <p>{t('footer.affiliation')}</p>
        <!-- The two institutions LIREI belongs to, not partners of it. -->
        <div class="footer-affiliations">
          <a
            class="uqtr-link footer-uqtr"
            href="https://www.uqtr.ca/"
            target="_blank"
            rel="noopener"
            title={t('site.uqtr')}>
            <img src={assetPath('/images/uqtr-logo.png')} alt={t('site.uqtr')} width="360" height="140" loading="lazy" />
          </a>
          <a
            class="uqtr-link footer-uqtr"
            href="https://oraprdnt.uqtr.uquebec.ca/portail/gscw031?owa_no_site=592"
            target="_blank"
            rel="noopener"
            title={t('footer.irh')}>
            <img src={assetPath('/images/partners/irh.jpg')} alt={t('footer.irh')} width="779" height="394" loading="lazy" />
          </a>
        </div>
      </div>
      <div>
        <h2>{t('footer.contactTitle')}</h2>
        <p>
          <a href="mailto:lirei.info@uqtr.ca">lirei.info@uqtr.ca</a><br />
          {t('footer.phone')}
        </p>
        <p>{t('footer.address')}</p>
      </div>
      <div>
        <h2>{t('nav.research')}</h2>
        <p>
          <a href={href(lang, 'research')}>{t('nav.research')}</a><br />
          <a href={href(lang, 'publications')}>{t('nav.publications')}</a><br />
          <a href={href(lang, 'news')}>{t('nav.news')}</a>
        </p>
      </div>
      <div>
        <h2>{t('nav.lab')}</h2>
        <p>
          <a href={href(lang, 'lab')}>{t('nav.overview')}</a><br />
          <a href={href(lang, 'labInfra')}>{t('nav.labInfra')}</a><br />
          <a href={href(lang, 'labPartners')}>{t('nav.labPartners')}</a><br />
          <a href={href(lang, 'alumni')}>{t('nav.alumni')}</a><br />
          <a href={href(lang, 'opportunities')}>{t('nav.opportunities')}</a>
        </p>
      </div>
    </div>
    <p class="fine">© {year} {t('site.name')} — {t('site.uqtr')}. {t('footer.rights')}</p>
  </div>
</footer>
