---
import { social, type SocialId } from '../data/social';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** 'footer' sits on the dark band; 'inline' on a light page. */
  variant?: 'footer' | 'inline';
  /** Shown above the icons on the contact page; the footer labels its own column. */
  heading?: boolean;
}

const { lang, variant = 'inline', heading = false } = Astro.props;
const t = useTranslations(lang);

// One path per network, drawn in a 24×24 box and filled with currentColor so a
// single icon works on both the dark footer and a light page.
const paths: Record<SocialId, string> = {
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.44v6.3zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
  youtube:
    'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z',
  x:
    'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z',
  facebook:
    'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.23 2.68.23v2.97h-1.5c-1.49 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z',
};
---

{
  social.length > 0 && (
    <div class:list={['social', `social--${variant}`]}>
      {heading && <p class="social-heading">{t('social.follow')}</p>}
      <ul aria-label={t('social.label')}>
        {social.map((account) => (
          <li>
            <a href={account.url} target="_blank" rel="noopener" title={account.name}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d={paths[account.id]} fill="currentColor" />
              </svg>
              <span class="visually-hidden">{account.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
