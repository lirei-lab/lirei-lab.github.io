---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MemberCard from '../MemberCard.astro';
import { useTranslations, assetPath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = ['direction', 'professor', 'staff', 'postdoc', 'student'] as const;
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const groups = categories
  .map((cat) => ({ cat, members: team.filter((m) => m.data.category === cat) }))
  .filter((g) => g.members.length > 0);
---

<Base lang={lang} routeKey="team" title={t('team.title')} description={t('team.lead')}>
  <div class="hero hero--compact">
    <div class="container">
      <h1>{t('team.title')}</h1>
      <p class="intro">{t('team.lead')}</p>
    </div>
  </div>

  <div class="container">
    <!-- The group before the individuals. Kept inside the container rather than
         full-bleed: the source is 1280 px wide and upscaling it would show. -->
    <figure class="team-group">
      <img
        src={assetPath('/images/team/groupe-lirei.webp')}
        alt={t('team.groupAlt')}
        width="1280"
        height="450"
        loading="lazy"
      />
      <figcaption class="muted">
        {t('team.groupCaption')} <span class="credit">{t('team.groupCredit')}</span>
      </figcaption>
    </figure>

    {groups.map(({ cat, members }) => (
      <section>
        <h2>{t(`team.groups.${cat}`)}</h2>
        <div class="grid-3">
          {members.map((member) => <MemberCard member={member} lang={lang} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
