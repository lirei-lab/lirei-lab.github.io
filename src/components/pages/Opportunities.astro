---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpeningCard from '../OpeningCard.astro';
import { useTranslations, href, formatDate, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = (await getCollection('openings')).sort((a, b) => a.data.order - b.data.order);
// Dated vacancies stand apart from standing invitations: only the first expire.
const dated = all.filter((o) => o.data.status === 'open');
const standing = all.filter((o) => o.data.status === 'ongoing');

// The case for joining is made with the laboratory's own numbers, not adjectives.
const pubs = await getCollection('publications');
const alumni = await getCollection('alumni');
const team = await getCollection('team');
const programs = (await getCollection('projects')).filter((p) => p.data.featured);
// Conference papers are counted, not asserted: it is the evidence behind the
// claim that students present their work abroad.
const isConference = (venue = '') => {
  const v = venue.toLowerCase();
  const journal = /transactions|journal|ieee access|energies|applied energy|renewable|letters|review/.test(v);
  const conf = /conference|congress|symposium|proceedings|workshop|colloque|meeting/.test(v);
  return conf && !(journal && !conf);
};
const confCount = pubs.filter((p) => isConference(p.data.venue)).length;

const facts = [
  { n: team.filter((m) => m.data.category === 'student').length, label: 'opportunities.factStudents' },
  { n: alumni.length, label: 'opportunities.factAlumni' },
  { n: pubs.length, label: 'opportunities.factPubs' },
  { n: confCount, label: 'opportunities.factConf' },
];

const steps = ['step1', 'step2', 'step3', 'step4'] as const;
const offers = ['offerCity', 'offerPeople', 'offerAfter', 'offerTraining'] as const;
---

<Base
  lang={lang}
  routeKey="opportunities"
  title={t('opportunities.title')}
  description={t('opportunities.lead')}>
  <div class="hero hero--compact">
    <div class="container">
      <h1>{t('opportunities.title')}</h1>
      <p class="intro">{t('opportunities.lead')}</p>
    </div>
  </div>

  <div class="container">
    <div class="stats">
      {facts.map((f) => (
        <div><span class="num">{f.n}</span><span class="label">{t(f.label)}</span></div>
      ))}
    </div>

    <section>
      <h2>{t('opportunities.whyTitle')}</h2>
      <div class="grid-2">
        {offers.map((k) => (
          <div class="card">
            <h3>{t(`opportunities.${k}Title`)}</h3>
            <p class="muted">{t(`opportunities.${k}Desc`)}</p>
          </div>
        ))}
      </div>
      <p class="muted more-links">
        <a href={href(lang, 'research')}>{t('research.title')} →</a>
        <a href={href(lang, 'alumni')}>{t('nav.alumni')} →</a>
        <a href={href(lang, 'publications')}>{t('nav.publications')} →</a>
      </p>
    </section>

    <section>
      <h2>{t('opportunities.openTitle')}</h2>
      <p class="muted" style="max-width:46rem">{t('opportunities.openLead')}</p>
      {dated.length === 0 ? (
        <p class="empty-note">{t('opportunities.openNone')}</p>
      ) : (
        <div class="opening-list">
          {dated.map((o) => <OpeningCard opening={o} lang={lang} />)}
        </div>
      )}
    </section>

    <section>
      <h2>{t('opportunities.ongoingTitle')}</h2>
      <p class="muted" style="max-width:46rem">{t('opportunities.ongoingLead')}</p>
      <div class="opening-list">
        {standing.map((o) => <OpeningCard opening={o} lang={lang} />)}
      </div>
    </section>

    <section>
      <h2>{t('opportunities.howTitle')}</h2>
      <p class="muted" style="max-width:46rem">{t('opportunities.howLead')}</p>
      <ol class="apply-steps">
        {steps.map((k) => (
          <li>
            <h3>{t(`opportunities.${k}Title`)}</h3>
            <p class="muted">{t(`opportunities.${k}Desc`)}</p>
          </li>
        ))}
      </ol>
      <p><a class="btn" href={href(lang, 'contact')}>{t('opportunities.apply')} →</a></p>
    </section>

    <section>
      <h2>{t('opportunities.moneyTitle')}</h2>
      <div class="grid-2" style="max-width:60rem">
        <p>{t('opportunities.money1')}</p>
        <p>{t('opportunities.money2')}</p>
      </div>
    </section>

    <section class="edi-note">
      <h2>{t('opportunities.ediTitle')}</h2>
      <p style="max-width:46rem">{t('opportunities.ediText')}</p>
      <p>
        <a href="https://www.uqtr.ca/" target="_blank" rel="noopener">
          {t('opportunities.ediLink')} →
        </a>
      </p>
    </section>
  </div>
</Base>
