---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import MemberCard from '../MemberCard.astro';
import PublicationItem from '../PublicationItem.astro';
import FlexArchitecture from '../diagrams/FlexArchitecture.astro';
import GreenhouseLoop from '../diagrams/GreenhouseLoop.astro';
import MicrogridLevels from '../diagrams/MicrogridLevels.astro';
import { useTranslations, href, otherLang, assetPath, type Lang } from '../../i18n';
import { authorMatchesPerson } from '../../utils/authors';
import { normalizePartners } from '../../utils/partners';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { title, summary, description, objective, methodology, period, lead, funding, volets,
  competence, status, partners, team, image, imageAlt } = project.data;
const switchHref = `${href(otherLang(lang), 'research')}/${project.id}`;
const paragraphs = (description?.[lang] ?? summary[lang]).split(/\n\n+/);

const allTeam = await getCollection('team');

// Two-way link: find the student whose profile points to this project.
const student = allTeam.find((m) => m.data.project === project.id);

// Flagship programs show an explanatory diagram instead of a stock illustration.
const diagramMap: Record<string, string> = {
  'energie-transactive': 'flex',
  'serres-quebec': 'serres',
  'communautes-isolees': 'comm',
};
const diagramFor = diagramMap[project.id];
const initials = (name: string) =>
  name.split(/\s+/).map((p) => p[0]).slice(0, 2).join('').toUpperCase();

// Program hub: a featured project that heads a research program.
const isProgram = project.data.featured && !!project.data.program;
let subProjects: CollectionEntry<'projects'>[] = [];
let programMembers: CollectionEntry<'team'>[] = [];
let programPublications: CollectionEntry<'publications'>[] = [];

if (isProgram) {
  const allProjects = await getCollection('projects');
  subProjects = allProjects
    .filter((p) => p.data.program === project.data.program && !p.data.featured)
    .sort((a, b) => a.data.title[lang].localeCompare(b.data.title[lang]));

  const subIds = new Set(subProjects.map((p) => p.id));
  // Someone can be attached to the program itself rather than to one of its
  // projects — a postdoctoral fellow working across it. Without this they were
  // recorded in the data and shown nowhere.
  programMembers = allTeam
    .filter((m) => m.data.project && (subIds.has(m.data.project) || m.data.project === project.id))
    .sort((a, b) => a.data.order - b.data.order);

  const people = programMembers.map((m) => m.data);
  programPublications = (await getCollection('publications'))
    .filter((p) => p.data.authors.some((a) => people.some((n) => authorMatchesPerson(n, a))))
    .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
}
---

<Base
  lang={lang}
  routeKey="research"
  title={title[lang]}
  description={summary[lang]}
  switchHref={switchHref}>
  <div class="hero hero--compact">
    <div class="container">
      <p class="hero-back"><a href={href(lang, 'research')}>{t('projects.back')}</a></p>
      <h1>{title[lang]}</h1>
      <p>
        <span class="tag">{t(`research.competences.${competence}.title`)}</span>
        <span class="tag blue">{t(`projects.${status}`)}</span>
      </p>
      {team && <p class="intro project-team">{team}</p>}
    </div>
  </div>

  <div class="container project-detail">
    {(period || lead || funding) && (
      <dl class="fiche">
        {period && (
          <div><dt>{t('projects.period')}</dt><dd>{period}</dd></div>
        )}
        {lead && (
          <div><dt>{t('projects.lead')}</dt><dd>{lead}</dd></div>
        )}
        {funding && (
          <div><dt>{t('projects.funding')}</dt><dd>{funding[lang]}</dd></div>
        )}
      </dl>
    )}

    {diagramFor === 'flex' ? (
      <div class="diagram-scroll"><FlexArchitecture lang={lang} /></div>
    ) : diagramFor === 'serres' ? (
      <div class="diagram-scroll"><GreenhouseLoop lang={lang} /></div>
    ) : diagramFor === 'comm' ? (
      <div class="diagram-scroll"><MicrogridLevels lang={lang} /></div>
    ) : (
      image && (
        <figure class="project-figure">
          <img src={assetPath(image)} alt={imageAlt?.[lang] ?? title[lang]} />
          {imageAlt && <figcaption class="muted">{imageAlt[lang]}</figcaption>}
        </figure>
      )
    )}

    <div class="project-body">
      {paragraphs.map((p) => <p>{p}</p>)}

      {objective && (
        <>
          <h2>{t('projects.objective')}</h2>
          <p>{objective[lang]}</p>
        </>
      )}

      {methodology && (
        <>
          <h2>{t('projects.methodology')}</h2>
          <p>{methodology[lang]}</p>
        </>
      )}

    </div>

    {partners.length > 0 && (
      <section>
        <h2>{t('projects.partners')}</h2>
        <ul class="partner-grid">
          {normalizePartners(partners).map((p) => {
            const Inner = p.logo
              ? <img src={assetPath(p.logo)} alt={p.name} loading="lazy" />
              : <span class="partner-name">{p.name}</span>;
            return (
              <li class="partner-tile" title={p.name}>
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener">{Inner}</a>
                ) : (
                  Inner
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {volets && volets.length > 0 && (
      <section>
        <h2>{t('projects.volets')}</h2>
        <ol class="volet-list">
          {volets.map((v) => (
            <li class="card volet">
              <h3>{v.title[lang]}</h3>
              <p class="muted">{v.desc[lang]}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {isProgram && subProjects.length > 0 && (
      <section>
        <h2>{t('projects.programProjects')}</h2>
        <div class="grid-3">
          {subProjects.map((p) => <ProjectCard project={p} lang={lang} compact />)}
        </div>
      </section>
    )}

    {isProgram && programMembers.length > 0 && (
      <section>
        <h2>{t('projects.programTeam')}</h2>
        <div class="grid-3">
          {programMembers.map((m) => <MemberCard member={m} lang={lang} />)}
        </div>
      </section>
    )}

    {isProgram && programPublications.length > 0 && (
      <section>
        <h2>{t('projects.programPubs')} ({programPublications.length})</h2>
        <ul class="pub-list">
          {programPublications.map((pub) => <PublicationItem pub={pub} lang={lang} />)}
        </ul>
      </section>
    )}

    {!isProgram && student && (
      <a class="card person-card" href={`${href(lang, 'team')}/${student.id}`}>
        {student.data.photo ? (
          <span class="avatar avatar--photo">
            <img src={assetPath(student.data.photo)} alt={student.data.name} loading="lazy" />
          </span>
        ) : (
          <svg class="avatar" width="72" height="72" viewBox="0 0 72 72" aria-hidden="true">
            <circle cx="36" cy="36" r="36" fill="var(--blue-100)" />
            <text x="36" y="46" text-anchor="middle" font-size="26" font-weight="700"
              fill="var(--blue-700)" font-family="system-ui, sans-serif">{initials(student.data.name)}</text>
          </svg>
        )}
        <span>
          <span class="person-label">{t('projects.student')}</span>
          <strong class="person-name">{student.data.name}</strong>
          <span class="muted">{student.data.role[lang]}</span>
        </span>
      </a>
    )}
  </div>
</Base>
