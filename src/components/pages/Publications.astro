---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PublicationItem from '../PublicationItem.astro';
import PubStats from '../PubStats.astro';
import TopicGraph from '../TopicGraph.astro';
import { allPeople } from '../../utils/authors';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title)
);
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const types = ['journal', 'conference', 'other'] as const;

// Names for the ?auteur= chip. A slug with no name here is ignored rather than
// filtering to nothing, so a stale or mistyped link shows the catalogue instead
// of an empty page.
const peopleNames = Object.fromEntries((await allPeople()).map((p) => [p.slug, p.name]));
---

<Base lang={lang} routeKey="publications" title={t('pubs.title')} description={t('pubs.lead')}>
  <div class="hero hero--compact">
    <div class="container">
      <h1>{t('pubs.title')}</h1>
      <p class="intro">{t('pubs.lead')}</p>
    </div>
  </div>

  <div class="container">
    <PubStats lang={lang} />

    <TopicGraph lang={lang} />

    <div class="filters" id="catalogue">
      <label for="f-type">{t('pubs.filterType')}</label>
      <select id="f-type">
        <option value="">{t('pubs.all')}</option>
        {types.map((type) => <option value={type}>{t(`pubs.${type}`)}</option>)}
      </select>
      <label for="f-year">{t('pubs.filterYear')}</label>
      <select id="f-year">
        <option value="">{t('pubs.all')}</option>
        {years.map((year) => <option value={String(year)}>{year}</option>)}
      </select>
      <button type="button" id="f-author" class="filter-chip topic-chip" data-label={t('pubs.filterAuthor')} hidden>
        <span></span><span aria-hidden="true">✕</span>
      </button>
      <button type="button" id="f-topic" class="filter-chip topic-chip" data-label={t('pubs.filterTopic')} hidden>
        <span></span><span aria-hidden="true">✕</span>
      </button>
    </div>

    <script type="application/json" id="people-names" set:html={JSON.stringify(peopleNames).replace(/</g, '\\u003c')}></script>

    {years.map((year) => (
      <section class="year-group" data-year={year}>
        <h2>{year}</h2>
        <ul class="pub-list">
          {pubs
            .filter((p) => p.data.year === year)
            .map((pub) => <PublicationItem pub={pub} lang={lang} />)}
        </ul>
      </section>
    ))}
    <p id="no-results" class="muted" hidden>{t('pubs.noResults')}</p>
  </div>

  <script>
    const typeSel = document.getElementById('f-type') as HTMLSelectElement;
    const yearSel = document.getElementById('f-year') as HTMLSelectElement;
    const topicBtn = document.getElementById('f-topic') as HTMLButtonElement;
    const authorBtn = document.getElementById('f-author') as HTMLButtonElement;
    const noResults = document.getElementById('no-results')!;
    const peopleNames: Record<string, string> = JSON.parse(
      document.getElementById('people-names')!.textContent!
    );
    let topic: string | null = null;
    let author: string | null = null;

    function apply() {
      const type = typeSel.value;
      const year = yearSel.value;
      let any = false;
      document.querySelectorAll<HTMLElement>('.year-group').forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLElement>('li').forEach((li) => {
          const show =
            (!type || li.dataset.type === type) &&
            (!year || li.dataset.year === year) &&
            (!topic || (li.dataset.topics ?? '').split(' ').includes(topic)) &&
            (!author || (li.dataset.people ?? '').split(' ').includes(author));
          li.hidden = !show;
          if (show) visible++;
        });
        group.hidden = visible === 0;
        if (visible > 0) any = true;
      });
      noResults.hidden = any;
    }

    /** Reflect the author filter in the address bar, so the view can be shared. */
    function setAuthor(slug: string | null, push = true) {
      author = slug && peopleNames[slug] ? slug : null;
      authorBtn.hidden = !author;
      if (author) authorBtn.firstElementChild!.textContent =
        `${authorBtn.dataset.label} ${peopleNames[author]}`;
      if (push) {
        const url = new URL(location.href);
        if (author) url.searchParams.set('auteur', author);
        else url.searchParams.delete('auteur');
        history.replaceState(null, '', url);
      }
      apply();
    }

    // Arriving from a person's entry elsewhere on the site: filter on load.
    // An unknown slug falls through to the unfiltered catalogue.
    setAuthor(new URLSearchParams(location.search).get('auteur'), false);
    authorBtn.addEventListener('click', () => setAuthor(null));

    typeSel.addEventListener('change', apply);
    yearSel.addEventListener('change', apply);

    // Selecting a topic on the map narrows this list; the chip both shows what
    // is active and clears it, telling the map to drop its selection too.
    document.addEventListener('topicfilter', (event) => {
      const detail = (event as CustomEvent).detail;
      topic = detail.topic;
      topicBtn.hidden = !topic;
      if (topic) topicBtn.firstElementChild!.textContent =
        `${topicBtn.dataset.label} ${detail.name}`;
      apply();
    });

    topicBtn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('topicfilter', { detail: { topic: null } }));
    });
  </script>
</Base>
