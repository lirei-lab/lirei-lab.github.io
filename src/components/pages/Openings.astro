---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { useTranslations, href, formatDate, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = (await getCollection('openings')).sort(
  (a, b) => a.data.order - b.data.order
);
// Dated vacancies first and on their own: they are the ones that expire.
const dated = all.filter((o) => o.data.status === 'open');
const standing = all.filter((o) => o.data.status === 'ongoing');
---

<Base lang={lang} routeKey="openings" title={t('openings.title')} description={t('openings.lead')}>
  <div class="hero hero--compact">
    <div class="container">
      <h1>{t('openings.title')}</h1>
      <p class="intro">{t('openings.lead')}</p>
    </div>
  </div>

  <div class="container">
    <section>
      <h2>{t('openings.openTitle')}</h2>
      <p class="muted" style="max-width:46rem">{t('openings.openLead')}</p>
      {dated.length === 0 ? (
        <p class="empty-note">{t('openings.openNone')}</p>
      ) : (
        <div class="opening-list">
          {dated.map((o) => (
            <article class="card opening">
              <div class="opening-head">
                <span class="tag">{t(`openings.types.${o.data.type}`)}</span>
                {o.data.deadline && (
                  <span class="tag blue">
                    {t('openings.deadline')} : {formatDate(o.data.deadline, lang)}
                  </span>
                )}
              </div>
              <h3>{o.data.title[lang]}</h3>
              <p>{o.data.summary[lang]}</p>
              {o.data.profile && (
                <>
                  <h4>{t('openings.profileTitle')}</h4>
                  <p class="muted">{o.data.profile[lang]}</p>
                </>
              )}
              {o.data.funding && (
                <>
                  <h4>{t('openings.fundingTitle')}</h4>
                  <p class="muted">{o.data.funding[lang]}</p>
                </>
              )}
              {o.data.programs && o.data.programs.length > 0 && (
                <p class="opening-programs">
                  {o.data.programs.map((p) => (
                    <a class="tag" href={href(lang, 'research')}>{t(`projects.programs.${p}`)}</a>
                  ))}
                </p>
              )}
              <p>
                <a class="btn" href={`${href(lang, 'contact')}?o=${o.data.type}`}>
                  {t('openings.apply')} →
                </a>
              </p>
            </article>
          ))}
        </div>
      )}
    </section>

    <section>
      <h2>{t('openings.ongoingTitle')}</h2>
      <p class="muted" style="max-width:46rem">{t('openings.ongoingLead')}</p>
      <div class="opening-list">
        {standing.map((o) => (
          <article class="card opening">
            <div class="opening-head">
              <span class="tag">{t(`openings.types.${o.data.type}`)}</span>
            </div>
            <h3>{o.data.title[lang]}</h3>
            <p>{o.data.summary[lang]}</p>
            {o.data.profile && (
              <>
                <h4>{t('openings.profileTitle')}</h4>
                <p class="muted">{o.data.profile[lang]}</p>
              </>
            )}
            {o.data.funding && (
              <>
                <h4>{t('openings.fundingTitle')}</h4>
                <p class="muted">{o.data.funding[lang]}</p>
              </>
            )}
            {o.data.programs && o.data.programs.length > 0 && (
              <p class="opening-programs">
                {o.data.programs.map((p) => (
                  <a class="tag" href={href(lang, 'research')}>{t(`projects.programs.${p}`)}</a>
                ))}
              </p>
            )}
            <p>
              <a class="btn" href={`${href(lang, 'contact')}?o=${o.data.type}`}>
                {t('openings.apply')} →
              </a>
            </p>
          </article>
        ))}
      </div>
    </section>

    <p class="muted apply-note">{t('openings.applyLead')}</p>
  </div>
</Base>
