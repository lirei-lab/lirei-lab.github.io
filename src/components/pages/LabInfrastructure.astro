---
import Base from '../../layouts/Base.astro';
import VideoEmbed from '../VideoEmbed.astro';
import { useTranslations, href, assetPath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Grouped so that physical facilities, computing platforms and data are not
// read as one undifferentiated list.
const groups = [
  { key: 'experimental', items: ['apartment', 'storage', 'growth', 'edge'] },
  { key: 'numeric', items: ['cluster', 'simulation'] },
  { key: 'data', items: ['datasets'] },
] as const;

// The building itself first, then how it sits in the city.
const videos = [
  { id: '51LyCIBn-08', key: 'pavVideoBuilding' },
  { id: 'KI72qQmFHwo', key: 'pavVideoCity' },
] as const;

// The work-environment row: seminars, benches, visits.
const envPhotos = [
  { src: '/images/lab/seminaire-hybride.webp', key: 'lab.envSeminarAlt' },
  { src: '/images/lab/postes-instrumentes.webp', key: 'lab.envBenchAlt' },
  { src: '/images/lab/banc-stockage-fortress.webp', key: 'lab.envStorageAlt' },
  { src: '/images/lab/lab2.webp', key: 'lab.envConversionAlt' },
  { src: '/images/lab/lab9.webp', key: 'lab.visitAlt' },
] as const;

// Each photograph sits beside the equipment it actually shows. The card crops
// to a 200 px band, so a photograph whose subject sits high in the frame needs
// to say where to anchor it — centring cut the heads off the two people
// standing by the edge cluster.
const photo: Record<string, { src: string; pos?: string }> = {
  // The dwelling itself, built inside the hall. The photograph here before it
  // showed the Victron wall — the conversion bench two cards down, not the flat.
  apartment: { src: '/images/lab/appartement-intelligent.webp', pos: 'center 45%' },
  // The equipment itself rather than a visit to it: the card names the Victron
  // Quattro and the Fortress cells, and these two frames show them.
  storage: { src: '/images/lab/banc-conversion-victron.webp' },
  growth: { src: '/images/lab/chambre-culture.webp', pos: 'center 35%' },
  edge: { src: '/images/lab/lab8.jpg', pos: 'center top' },
  cluster: { src: '/images/lab/lab5.webp' },
  simulation: { src: '/images/lab/lab3.webp' },
  datasets: { src: '/images/lab/lab6.webp' },
};
---

<Base lang={lang} routeKey="labInfra" title={t('lab.infraTitle')} description={t('lab.infraLead')}>
  <div class="hero hero--compact">
    <div class="container">
      <p class="hero-back"><a href={href(lang, 'lab')}>← {t('nav.lab')}</a></p>
      <h1>{t('lab.infraTitle')}</h1>
      <p class="intro">{t('lab.infraLead')}</p>
    </div>
  </div>

  <div class="container">
    <section class="pavillon">
      <p class="tag blue">{t('lab.pavillonTag')}</p>
      <h2>{t('lab.pavillonTitle')}</h2>
      <p class="lead">{t('lab.pavillonLead')}</p>
      <div class="grid-2">
        <p>{t('lab.pavillonBody')}</p>
        <p>
          {t('lab.pavillonBody2')}
          <br />
          <a
            href="https://oraprdnt.uqtr.uquebec.ca/portail/gscw031?owa_no_site=7812"
            target="_blank"
            rel="noopener">{t('lab.pavillonLink')} →</a>
        </p>
      </div>
      <div class="video-pair">
        {videos.map((v) => (
          <VideoEmbed
            id={v.id}
            title={t(`lab.${v.key}Title`)}
            caption={t(`lab.${v.key}Caption`)}
            credit={t('lab.pavillonCredit')}
          />
        ))}
      </div>
    </section>

    {groups.map((g) => (
      <section class="infra-group">
        <h2>{t(`lab.infraGroups.${g.key}.title`)}</h2>
        <p class="muted" style="max-width:46rem">{t(`lab.infraGroups.${g.key}.desc`)}</p>
        <div class="grid-2">
          {g.items.map((key) => (
            <div class="card infra-card">
              <span class="infra-photo">
                <img
                  src={assetPath(photo[key].src)}
                  alt={t(`lab.infra.${key}.title`)}
                  style={photo[key].pos ? `object-position:${photo[key].pos}` : undefined}
                  loading="lazy"
                />
              </span>
              <div class="infra-body">
                <h3>{t(`lab.infra.${key}.title`)}</h3>
                <p class="muted" style="font-size:0.94rem">{t(`lab.infra.${key}.desc`)}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="infra-group">
      <h2>{t('lab.envTitle')}</h2>
      <div class="grid-2" style="max-width:60rem">
        <p>{t('lab.env1')}</p>
        <p>{t('lab.env2')}</p>
      </div>
      <!-- Three sides of how the work actually happens: dissemination, the
           bench, and the visits the industrial interest brings. -->
      <div class="env-photos">
        {envPhotos.map((p) => (
          <figure>
            <img src={assetPath(p.src)} alt={t(p.key)} loading="lazy" />
            <figcaption class="muted">{t(p.key)}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>

  <section class="band cta-band">
    <div class="container">
      <h2 style="margin-top:0">{t('lab.ctaTitle')}</h2>
      <p style="max-width:44rem">{t('lab.ctaText')}</p>
      <p><a class="btn" href={href(lang, 'contact')}>{t('lab.ctaBtn')} →</a></p>
    </div>
  </section>
</Base>
