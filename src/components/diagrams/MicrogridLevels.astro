---
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const d = (k: string) => t(`diagrams.comm.${k}`);

// Two management levels above the physical resources, as in the program's
// NSERC proposal: envelopes set safe limits, agents act inside them.
const W = 780;
const H = 430;
const cx = W / 2;

const layers = [
  { y: 30, h: 66, label: d('layerPlan') },
  { y: 172, h: 54, label: d('layerReal') },
  { y: 316, h: 74, label: d('layerRes') },
];

const bandTop = (i: number) => layers[i].y - 22;
const bandBottom = (i: number) => layers[i].y - 22 + layers[i].h + 34;
const gapUpper = (bandBottom(0) + bandTop(1)) / 2 + 4;
const downX = cx + 150;
const upX = cx - 150;

const resources = [
  { x: 40, label: d('wind'), icon: 'M16 28V16 M16 15L16 3 M16 16l10 6 M16 16L6 22' },
  { x: 220, label: d('solar'), icon: 'M4 22L10 6h14l-6 16z M8 12h14M6 17h14M17 6l-5 16' },
  { x: 400, label: d('storage'), icon: 'M4 10h20v12H4z M24 14v4 M8 13v6M13 13v6M18 13v6' },
  { x: 580, label: d('loads'), icon: 'M4 14L16 4l12 10 M8 13v12h16V13 M14 25v-7h4v7' },
];
const rw = 156;
---

<figure class="diagram-figure">
  <svg class="diagram" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={d('alt')}>
    <title>{d('title')}</title>
    <desc>{d('alt')}</desc>

    <defs>
      <marker id="mg-up" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="mk-up" />
      </marker>
      <marker id="mg-down" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="mk-down" />
      </marker>
    </defs>

    {layers.map((l) => (
      <g>
        <rect class="band" x="8" y={l.y - 22} width={W - 16} height={l.h + 34} rx="10" />
        <text class="band-label" x="20" y={l.y - 6}>{l.label}</text>
      </g>
    ))}

    <!-- flows run between layers, never into a single block -->
    <path class="flow down" d={`M ${downX} ${bandBottom(0)} L ${downX} ${bandTop(1)}`} marker-end="url(#mg-down)" />
    <path class="flow down" d={`M ${downX} ${bandBottom(1)} L ${downX} ${bandTop(2)}`} marker-end="url(#mg-down)" />
    <text class="flow-label down" x={downX - 10} y={gapUpper} text-anchor="end">{d('flowDown')}</text>

    <path class="flow up" d={`M ${upX} ${bandTop(2)} L ${upX} ${bandBottom(1)}`} marker-end="url(#mg-up)" />
    <path class="flow up" d={`M ${upX} ${bandTop(1)} L ${upX} ${bandBottom(0)}`} marker-end="url(#mg-up)" />
    <text class="flow-label up" x={upX + 10} y={gapUpper}>{d('flowUp')}</text>

    <!-- planning level -->
    <g>
      <rect class="node node--market" x="150" y={layers[0].y} width="480" height={layers[0].h} rx="8" />
      <text class="node-label" x={cx} y={layers[0].y + 27} text-anchor="middle">{d('doe')}</text>
      <text class="node-sub" x={cx} y={layers[0].y + 48} text-anchor="middle">{d('stoch')}</text>
    </g>

    <!-- real-time level -->
    <g>
      <rect class="node node--aggreg" x="190" y={layers[1].y} width="400" height={layers[1].h} rx="8" />
      <text class="node-label" x={cx} y={layers[1].y + layers[1].h / 2 + 5} text-anchor="middle">{d('marl')}</text>
    </g>

    <!-- resources -->
    {resources.map((r) => (
      <g>
        <rect class="node node--client" x={r.x} y={layers[2].y} width={rw} height={layers[2].h} rx="8" />
        <g class="client-icon" transform={`translate(${r.x + rw / 2 - 15} ${layers[2].y + 12})`}>
          <path d={r.icon} />
        </g>
        <text class="node-label small" x={r.x + rw / 2} y={layers[2].y + 62} text-anchor="middle">{r.label}</text>
      </g>
    ))}
  </svg>
  <figcaption class="muted">{d('caption')}</figcaption>
</figure>
