---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, href, otherLang, type Lang, type RouteKey } from '../i18n';
import { social } from '../data/social';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title: string;
  description: string;
  switchHref?: string;
}

const { lang, routeKey, title, description, switchHref } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const pageTitle = `${title} | ${t('site.name')} — ${t('site.uqtr')}`;

// Absolute URLs: hreflang, canonical and og:image are only honoured as such.
const site = Astro.site ?? new URL('https://lirei.ca');
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(Astro.url.pathname);

// Astro writes directory-style URLs, so canonical ends in a slash while the
// route helpers that build the alternates do not. Two spellings of one address
// weaken the pairing these tags exist to declare.
const withSlash = (u: string) => (u.endsWith('/') ? u : `${u}/`);
// The other language's address for *this* page: `switchHref` when a detail page
// supplies it, the section landing page otherwise.
const alternate = withSlash(abs(switchHref ?? href(other, routeKey)));
const frUrl = lang === 'fr' ? canonical : alternate;
const enUrl = lang === 'en' ? canonical : alternate;
const ogImage = abs(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/og-lirei.jpg`);

// Structured data, so a search engine can tell what this organisation is
// rather than inferring it from the prose.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: t('site.name'),
  alternateName: t('site.fullname'),
  url: site.href,
  logo: ogImage,
  email: 'lirei.info@uqtr.ca',
  // Asserts that these profiles are the organisation's own. Omitted entirely
  // when there are none — an empty sameAs says nothing and validates worse.
  ...(social.length > 0 && { sameAs: social.map((a) => a.url) }),
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: t('site.uqtr'),
    url: 'https://www.uqtr.ca/',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3351, boul. des Forges, C.P. 500',
    addressLocality: 'Trois-Rivières',
    addressRegion: 'QC',
    postalCode: 'G9A 5H7',
    addressCountry: 'CA',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <!-- The French version of this page. It used to be the French version of
         this page's *section*, which told search engines that every project and
         every posting was the same document as its index. -->
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Header lang={lang} routeKey={routeKey} switchHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        const targets = document.querySelectorAll<HTMLElement>(
          'main .card, main .stats > div, main .pub-list li, main section.band, main h2'
        );
        // Only animate elements below the fold: content visible on load stays visible.
        targets.forEach((el, i) => {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
          el.classList.add('reveal');
          el.style.setProperty('--reveal-delay', `${(i % 5) * 70}ms`);
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
